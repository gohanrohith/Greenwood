<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/emblem.png">
  <link rel="apple-touch-icon" href="/emblem.png">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site-main">
<%- include('../../partials/topbar') %>
<%- include('../../partials/nav-main') %>
<main>
  <section class="page-hero">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <h1>Cookie Policy</h1>
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/compliance">Compliance</a> / Cookie Policy</div>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:820px">
      <div style="background:var(--white);border-radius:var(--radius-lg);padding:3rem;box-shadow:var(--shadow)">
        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">What Are Cookies?</h2>
        <p style="color:var(--gray);margin-bottom:1.5rem;line-height:1.8">Cookies are small text files stored on your device when you visit a website. They help the website remember your preferences and enable certain features to work correctly.</p>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Cookies We Use</h2>
        <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem">
          <div style="background:var(--off-white);padding:1.25rem;border-radius:var(--radius)">
            <strong style="color:var(--navy)">Session Cookies (Essential)</strong>
            <p style="color:var(--gray);font-size:.88rem;margin-top:.4rem;line-height:1.7">Required for website functionality. Used for admin login sessions and form security tokens. These are deleted when you close your browser and cannot be disabled without breaking site features.</p>
          </div>
          <div style="background:var(--off-white);padding:1.25rem;border-radius:var(--radius)">
            <strong style="color:var(--navy)">Analytics Cookies (Optional)</strong>
            <p style="color:var(--gray);font-size:.88rem;margin-top:.4rem;line-height:1.7">If analytics tools are enabled, cookies may track page visits and traffic sources to help us improve the website. No personally identifiable information is collected.</p>
          </div>
        </div>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Managing Cookies</h2>
        <p style="color:var(--gray);margin-bottom:1.5rem;line-height:1.8">You can control and delete cookies through your browser settings. Most browsers allow you to refuse cookies or delete existing ones. Note that disabling session cookies will prevent admin login functionality. Third-party embedded content (such as Google Maps) may set their own cookies governed by their respective policies.</p>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Contact</h2>
        <p style="color:var(--gray);line-height:1.8">For questions about our cookie practices, email <a href="mailto:office@ghs.ac.in" style="color:var(--green)">office@ghs.ac.in</a>.</p>
      </div>
    </div>
  </section>
</main>
<%- include('../../partials/footer-main') %>
<script src="/js/main.js"></script>
</body>
</html>
