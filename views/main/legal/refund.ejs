<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/emblem.png">
  <link rel="apple-touch-icon" href="/emblem.png">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site-main">
<%- include('../../partials/topbar') %>
<%- include('../../partials/nav-main') %>
<main>
  <section class="page-hero">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <h1>Refund Policy</h1>
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/compliance">Compliance</a> / Refund Policy</div>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:820px">
      <div style="background:var(--white);border-radius:var(--radius-lg);padding:3rem;box-shadow:var(--shadow)">
        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Admission Fee</h2>
        <p style="color:var(--gray);margin-bottom:1.5rem;line-height:1.8">The admission/registration fee paid at the time of enrollment is non-refundable in all circumstances. This fee covers administrative costs associated with processing the application.</p>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Tuition Fee Refund</h2>
        <p style="color:var(--gray);margin-bottom:.75rem;line-height:1.8">In the event of withdrawal from school, tuition fee refunds are as follows:</p>
        <div style="overflow-x:auto;margin-bottom:1.5rem">
          <table style="width:100%;border-collapse:collapse;font-size:.88rem">
            <thead><tr style="background:var(--navy);color:var(--white)">
              <th style="padding:10px 16px;text-align:left">Withdrawal Timing</th>
              <th style="padding:10px 16px;text-align:left">Refund Applicable</th>
            </tr></thead>
            <tbody>
              <% [
                ['Before commencement of academic year', '100% of term fees paid (less admission fee)'],
                ['Within first 15 days of term', '75% of term fees paid'],
                ['Between 16th and 30th day of term', '50% of term fees paid'],
                ['After 30 days of term commencement', 'No refund'],
                ['Mid-year withdrawal (after June 30)', 'No refund of fees paid for the year'],
              ].forEach((row, i) => { %>
              <tr style="border-bottom:1px solid var(--gray-light);background:<%= i % 2 === 0 ? 'var(--white)' : 'var(--off-white)' %>">
                <td style="padding:10px 16px;color:var(--gray-dark)"><%= row[0] %></td>
                <td style="padding:10px 16px;color:var(--gray)"><%= row[1] %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Hostel Fees (Hasanparthy)</h2>
        <p style="color:var(--gray);margin-bottom:1.5rem;line-height:1.8">Hostel fees are charged per term. If a student vacates mid-term due to medical emergency or family circumstances, a proportionate refund may be considered at the discretion of the Principal, upon submission of supporting documentation.</p>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Refund Process</h2>
        <p style="color:var(--gray);margin-bottom:1.5rem;line-height:1.8">Refund requests must be submitted in writing to the Campus Principal along with the original fee receipt. Approved refunds are processed within 30 working days via the original payment method or by account transfer.</p>

        <h2 style="color:var(--navy);font-size:1.15rem;margin-bottom:.75rem">Contact</h2>
        <p style="color:var(--gray);line-height:1.8">For refund queries, contact the campus office directly or email <a href="mailto:office@ghs.ac.in" style="color:var(--green)">office@ghs.ac.in</a>.</p>
      </div>
    </div>
  </section>
</main>
<%- include('../../partials/footer-main') %>
<script src="/js/main.js"></script>
</body>
</html>
