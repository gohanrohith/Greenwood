<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/emblem.png">
  <link rel="apple-touch-icon" href="/emblem.png"><title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="site-admin">
<div class="admin-wrapper">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-content">
    <%- include('../partials/admin-topbar') %>
    <div class="admin-body">
      <div class="admin-page-header"><h1>Concerns &amp; Queries</h1></div>

      <% if (success) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> Updated.</div>
      <% } %>

      <!-- Filters -->
      <div class="admin-card" style="margin-bottom:1.25rem">
        <form method="GET" action="/admin/concerns" style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap">
          <div class="form-group" style="margin:0;min-width:160px">
            <label style="font-size:.8rem;color:var(--gray);font-weight:600">Status</label>
            <select name="status" style="margin-top:.3rem">
              <option value="">All Statuses</option>
              <option value="new"         <%= filters.status==='new'         ? 'selected':'' %>>New</option>
              <option value="in_progress" <%= filters.status==='in_progress' ? 'selected':'' %>>In Progress</option>
              <option value="resolved"    <%= filters.status==='resolved'    ? 'selected':'' %>>Resolved</option>
              <option value="closed"      <%= filters.status==='closed'      ? 'selected':'' %>>Closed</option>
            </select>
          </div>
          <div class="form-group" style="margin:0;min-width:160px">
            <label style="font-size:.8rem;color:var(--gray);font-weight:600">Campus</label>
            <select name="campus" style="margin-top:.3rem">
              <option value="">All Campuses</option>
              <option value="hasanparthy"  <%= filters.campus==='hasanparthy'  ? 'selected':'' %>>Hasanparthy</option>
              <option value="naimnagar"    <%= filters.campus==='naimnagar'    ? 'selected':'' %>>Naimnagar</option>
              <option value="hunterroad"   <%= filters.campus==='hunterroad'   ? 'selected':'' %>>Hunter Road</option>
              <option value="mancherial"   <%= filters.campus==='mancherial'   ? 'selected':'' %>>Mancherial</option>
              <option value="gopalpur"     <%= filters.campus==='gopalpur'     ? 'selected':'' %>>Gopalpur</option>
              <option value="main"         <%= filters.campus==='main'         ? 'selected':'' %>>General</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Filter</button>
          <% if (filters.status || filters.campus) { %>
          <a href="/admin/concerns" class="btn btn-outline btn-sm">Clear</a>
          <% } %>
        </form>
      </div>

      <div class="admin-card">
        <% if (!concerns || concerns.length === 0) { %>
          <div class="empty-state"><i class="fas fa-comments"></i><p>No concerns found.</p></div>
        <% } else { %>
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Campus</th>
                <th>Category</th>
                <th>Message</th>
                <th>Status</th>
                <th>Date</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              <% concerns.forEach(c => { %>
              <tr>
                <td>
                  <strong><%= c.name %></strong>
                  <% if (c.email) { %><br><small style="color:#aaa"><%= c.email %></small><% } %>
                </td>
                <td><%= c.phone %></td>
                <td><span class="badge"><%= c.campus %></span></td>
                <td><span class="badge badge-info"><%= c.category %></span></td>
                <td style="max-width:280px;word-break:break-word;font-size:.82rem"><%= c.message.length > 120 ? c.message.slice(0,120) + '…' : c.message %></td>
                <td>
                  <form action="/admin/concerns/<%= c.id %>/status" method="POST" style="display:flex;flex-direction:column;gap:.4rem">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="status" onchange="this.form.submit()" class="status-select status-<%= c.status %>">
                      <option value="new"         <%= c.status==='new'         ? 'selected':'' %>>New</option>
                      <option value="in_progress" <%= c.status==='in_progress' ? 'selected':'' %>>In Progress</option>
                      <option value="resolved"    <%= c.status==='resolved'    ? 'selected':'' %>>Resolved</option>
                      <option value="closed"      <%= c.status==='closed'      ? 'selected':'' %>>Closed</option>
                    </select>
                  </form>
                </td>
                <td style="white-space:nowrap"><%= new Date(c.created_at).toLocaleDateString('en-IN') %></td>
                <td>
                  <form action="/admin/concerns/<%= c.id %>/status" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="<%= c.status %>">
                    <input type="text" name="admin_notes" value="<%= c.admin_notes || '' %>" placeholder="Add notes…"
                      style="font-size:.78rem;padding:.3rem .5rem;border:1px solid #ddd;border-radius:4px;width:140px">
                    <button type="submit" class="btn btn-sm btn-outline" style="margin-top:.3rem;font-size:.75rem">Save</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

    </div>
  </div>
</div>
<script src="/js/admin.js"></script>
</body>
</html>
