<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/emblem.png">
  <link rel="apple-touch-icon" href="/emblem.png">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .gallery-admin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-top:1rem}
    .gallery-admin-item{border-radius:8px;overflow:hidden;background:#f4f4f4}
    .gallery-admin-item .item-img-wrap{position:relative;aspect-ratio:1}
    .gallery-admin-item .item-img-wrap img{width:100%;height:100%;object-fit:cover;display:block}
    .gallery-admin-item .item-caption{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.6);color:#fff;font-size:.7rem;padding:4px 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .gallery-admin-item .item-controls{display:flex;align-items:center;justify-content:space-between;padding:5px 7px;gap:.4rem}
    .gallery-drag-handle{cursor:grab;color:#aaa;font-size:.9rem;line-height:1;padding:2px 4px}
    .gallery-drag-handle:active{cursor:grabbing}
    .sortable-ghost{opacity:.35;outline:2px dashed #6c63ff}
    .sort-disabled .gallery-drag-handle{cursor:default;opacity:.35}
  </style>
</head>
<body class="site-admin">
<div class="admin-wrapper">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-content">
    <%- include('../partials/admin-topbar') %>
    <div class="admin-body">
      <div class="admin-page-header"><h1>Gallery</h1></div>

      <div class="admin-card">
        <h3>Upload Images</h3>
        <form action="/admin/gallery/upload?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="admin-form">
          <div class="form-row">
            <div class="form-group">
              <label>Caption</label>
              <input type="text" name="caption" placeholder="e.g. Annual Sports Day 2026">
            </div>
            <div class="form-group">
              <label>Campus</label>
              <select name="campus">
                <option value="hasanparthy">Hasanparthy</option>
                <option value="hunterroad">Hunter Road</option>
                <option value="naimnagar">Naimnagar</option>
                <option value="mancherial">Mancherial</option>
                <option value="gopalpur">Gopalpur</option>
                <option value="main">Main Website</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Images * (JPG/PNG, up to 10 files, max 5MB each)</label>
            <input type="file" name="images" multiple accept="image/*" required>
          </div>
          <button type="submit" class="btn btn-primary">Upload</button>
        </form>
      </div>

      <div class="admin-card">
        <h3>Gallery Items (<%= typeof gallery !== 'undefined' && gallery ? gallery.length : 0 %>)</h3>
        <% if (typeof gallery === 'undefined' || !gallery || gallery.length === 0) { %>
        <div class="empty-state"><i class="fas fa-images"></i><p>No gallery items yet. Upload images above.</p></div>
        <% } else { %>

        <!-- Filter by campus -->
        <div style="margin-bottom:1rem;display:flex;gap:.5rem;flex-wrap:wrap">
          <span style="font-size:.82rem;color:var(--gray);align-self:center">Filter:</span>
          <% const campuses = [...new Set(gallery.map(g => g.campus))]; %>
          <% campuses.forEach(c => { %>
          <button class="btn btn-sm btn-outline campus-filter-btn" data-campus="<%= c %>" style="font-size:.76rem"><%= c %></button>
          <% }) %>
          <button class="btn btn-sm btn-outline campus-filter-btn active" data-campus="all" style="font-size:.76rem">All</button>
        </div>

        <p id="sortNote" style="font-size:.78rem;color:var(--gray);margin-bottom:.5rem">
          <i class="fas fa-info-circle"></i> Drag photos to reorder. Sorting is disabled when a campus filter is active.
        </p>
        <div class="gallery-admin-grid" id="galleryGrid" data-csrf="<%= csrfToken %>">
          <% gallery.forEach(item => { %>
          <div class="gallery-admin-item" data-campus="<%= item.campus %>" data-photo-id="<%= item.id %>">
            <div class="item-img-wrap">
              <img src="/uploads/gallery/<%= item.filename %>" alt="<%= item.caption || '' %>" loading="lazy">
              <% if (item.caption) { %><div class="item-caption"><%= item.caption %></div><% } %>
            </div>
            <div class="item-controls">
              <span class="gallery-drag-handle" title="Drag to reorder"><i class="fas fa-grip-horizontal"></i></span>
              <form action="/admin/gallery/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Delete this image?')" style="margin:0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-xs btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.6/Sortable.min.js"></script>
<script src="/js/admin.js"></script>
<script>
(function () {
  var grid = document.getElementById('galleryGrid');
  var sortNote = document.getElementById('sortNote');
  if (!grid || typeof Sortable === 'undefined') return;

  var sortable = Sortable.create(grid, {
    animation: 150,
    handle: '.gallery-drag-handle',
    ghostClass: 'sortable-ghost',
    filter: '[style*="display: none"],[style*="display:none"]',
    onEnd: function () {
      var ids = [].slice.call(grid.querySelectorAll('[data-photo-id]'))
        .filter(function (el) { return el.style.display !== 'none'; })
        .map(function (el) { return el.dataset.photoId; });
      var params = new URLSearchParams();
      params.append('_csrf', grid.dataset.csrf);
      ids.forEach(function (id) { params.append('ids[]', id); });
      fetch('/admin/gallery/reorder', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params
      }).catch(function () {});
    }
  });

  document.querySelectorAll('.campus-filter-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.campus-filter-btn').forEach(function (b) { b.classList.remove('active'); });
      this.classList.add('active');
      var campus = this.dataset.campus;
      var isAll = campus === 'all';
      document.querySelectorAll('.gallery-admin-item').forEach(function (item) {
        item.style.display = (isAll || item.dataset.campus === campus) ? '' : 'none';
      });
      sortable.option('disabled', !isAll);
      grid.classList.toggle('sort-disabled', !isAll);
      if (sortNote) sortNote.style.display = isAll ? '' : 'none';
    });
  });
})();
</script>
</body>
</html>
