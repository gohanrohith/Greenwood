<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="site-admin">
<div class="admin-wrapper">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-content">
    <%- include('../partials/admin-topbar') %>
    <div class="admin-body">
      <div class="admin-page-header">
        <h1>Downloads</h1>
        <p>Manage downloadable files shown on campus Download pages (forms, calendars, brochures).</p>
      </div>

      <div class="admin-card">
        <h3>Upload File</h3>
        <form action="/downloads/upload?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="admin-form">
          <div class="form-row">
            <div class="form-group">
              <label>Label / Title *</label>
              <input type="text" name="label" required placeholder="e.g. Academic Calendar 2026-27">
            </div>
            <div class="form-group">
              <label>Campus</label>
              <select name="campus">
                <option value="all">All Campuses</option>
                <option value="hasanparthy">Hasanparthy</option>
                <option value="hunterroad">Hunter Road</option>
                <option value="naimnagar">Naimnagar</option>
                <option value="mancherial">Mancherial</option>
                <option value="gopalpur">Gopalpur</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Category</label>
              <select name="category">
                <option value="admission">Admission Forms</option>
                <option value="calendar">Academic Calendar</option>
                <option value="form">General Forms</option>
                <option value="circular">Circulars</option>
                <option value="result">Results</option>
                <option value="academic">Academic Documents</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label>Description</label>
              <input type="text" name="description" placeholder="Brief description (optional)">
            </div>
          </div>
          <div class="form-group">
            <label>File * (PDF/DOC/Image, max 20MB)</label>
            <input type="file" name="file" required accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
          </div>
          <button type="submit" class="btn btn-primary">Upload File</button>
        </form>
      </div>

      <div class="admin-card">
        <h3>All Downloads (<%= downloads ? downloads.length : 0 %>)</h3>
        <% if (!downloads || downloads.length === 0) { %>
        <div class="empty-state"><i class="fas fa-download"></i><p>No downloadable files yet. Upload one above.</p></div>
        <% } else { %>
        <table class="admin-table">
          <thead>
            <tr><th>Title</th><th>Campus</th><th>Category</th><th>File</th><th>Date</th><th>Action</th></tr>
          </thead>
          <tbody>
            <% downloads.forEach(dl => { %>
            <tr>
              <td><strong><%= dl.label %></strong></td>
              <td><span class="badge"><%= dl.campus %></span></td>
              <td><span class="badge badge-info"><%= dl.category %></span></td>
              <td><a href="/uploads/downloads/<%= dl.filename %>" target="_blank" class="btn btn-sm btn-outline">View</a></td>
              <td><%= new Date(dl.created_at).toLocaleDateString('en-IN') %></td>
              <td>
                <form action="/downloads/<%= dl.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this file?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script src="/js/admin.js"></script>
</body>
</html>
