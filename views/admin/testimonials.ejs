<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <link rel="icon" type="image/png" href="/emblem.png">
  <link rel="apple-touch-icon" href="/emblem.png">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="site-admin">
<div class="admin-wrapper">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-content">
    <%- include('../partials/admin-topbar') %>
    <div class="admin-body">

      <div class="admin-page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.75rem">
        <h1>Testimonials & Reviews</h1>
        <form method="POST" action="/admin/testimonials/google-sync" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-outline" style="display:flex;align-items:center;gap:.5rem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21.35 11.1H12v2.8h5.35c-.5 2.3-2.5 3.9-5.35 3.9-3.3 0-6-2.7-6-6s2.7-6 6-6c1.5 0 2.9.6 3.95 1.55L18.1 5.1C16.45 3.55 14.35 2.6 12 2.6 6.75 2.6 2.5 6.85 2.5 12.1s4.25 9.5 9.5 9.5c5.5 0 9.1-3.85 9.1-9.3 0-.7-.1-1.25-.25-1.7z" fill="#4285F4"/></svg>
            Sync Google Reviews
          </button>
        </form>
      </div>

      <% if (success) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success === '1' ? 'Saved.' : success %></div>
      <% } %>
      <% if (error) { %>
      <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>

      <% if (settings && settings.google_overall_rating) { %>
      <div class="admin-card" style="margin-bottom:1.5rem;background:linear-gradient(135deg,#f0f9f4,#e8f5e9);border:1px solid #c8e6c9">
        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
          <svg width="28" height="28" viewBox="0 0 24 24"><path d="M21.35 11.1H12v2.8h5.35c-.5 2.3-2.5 3.9-5.35 3.9-3.3 0-6-2.7-6-6s2.7-6 6-6c1.5 0 2.9.6 3.95 1.55L18.1 5.1C16.45 3.55 14.35 2.6 12 2.6 6.75 2.6 2.5 6.85 2.5 12.1s4.25 9.5 9.5 9.5c5.5 0 9.1-3.85 9.1-9.3 0-.7-.1-1.25-.25-1.7z" fill="#4285F4"/></svg>
          <div>
            <div style="display:flex;align-items:center;gap:.5rem">
              <strong style="font-size:1.4rem;color:#1a1a1a"><%= parseFloat(settings.google_overall_rating).toFixed(1) %></strong>
              <% const gr = Math.round(parseFloat(settings.google_overall_rating)); %>
              <span>
                <% for(let i=1;i<=5;i++) { %><i class="fas fa-star" style="color:<%= i<=gr ? '#FBBF24' : '#D1D5DB' %>;font-size:.85rem"></i><% } %>
              </span>
            </div>
            <span style="font-size:.8rem;color:#555">Google rating · Last synced from Google</span>
          </div>
        </div>
      </div>
      <% } %>

      <div style="display:grid;grid-template-columns:1fr 1.6fr;gap:1.5rem;align-items:start">

        <div class="admin-card">
          <h3>Add Testimonial</h3>
          <form action="/admin/testimonials/create" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label>Name *</label>
              <input type="text" name="name" required placeholder="e.g. Ramesh Kumar">
            </div>
            <div class="form-group">
              <label>Role</label>
              <input type="text" name="role" placeholder="Parent, Alumni…" value="Parent">
            </div>
            <div class="form-group">
              <label>Campus</label>
              <select name="campus">
                <option value="">All / General</option>
                <option value="Hasanparthy Campus">Hasanparthy Campus</option>
                <option value="Hunter Road Campus">Hunter Road Campus</option>
                <option value="Naimnagar Campus">Naimnagar Campus</option>
                <option value="Mancherial Campus">Mancherial Campus</option>
                <option value="Gopalpur Campus">Gopalpur Campus</option>
              </select>
            </div>
            <div class="form-group">
              <label>Rating</label>
              <div style="display:flex;gap:.35rem;font-size:1.4rem;cursor:pointer" id="starPicker">
                <% for(let i=1;i<=5;i++) { %>
                <label style="cursor:pointer;color:#FBBF24">
                  <input type="radio" name="rating" value="<%= i %>" style="display:none" <%= i===5?'checked':'' %>>
                  <i class="fas fa-star star-btn" data-val="<%= i %>"></i>
                </label>
                <% } %>
              </div>
            </div>
            <div class="form-group">
              <label>Quote *</label>
              <textarea name="quote" rows="4" required placeholder="What they said about Greenwood…"></textarea>
            </div>
            <div class="form-group">
              <label>Sort Order <span style="font-weight:400;color:var(--admin-gray)">(lower = first)</span></label>
              <input type="number" name="sort_order" value="0" min="0">
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add</button>
          </form>
        </div>

        <div>
          <% if (testimonials.length > 0) { %>
          <% testimonials.forEach(t => { %>
          <div class="admin-card" style="margin-bottom:.85rem;padding:1rem 1.25rem">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem">
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.4rem;flex-wrap:wrap">
                  <% const stars = parseInt(t.rating)||5; %>
                  <span>
                    <% for(let i=1;i<=5;i++) { %><i class="fas fa-star" style="font-size:.7rem;color:<%= i<=stars?'#FBBF24':'#D1D5DB' %>"></i><% } %>
                  </span>
                  <% if(t.source==='google') { %>
                  <span style="display:inline-flex;align-items:center;gap:.25rem;background:#f0f4ff;border:1px solid #c5d0e8;border-radius:10px;padding:.1rem .45rem;font-size:.68rem;color:#4285f4;font-weight:600">
                    <svg width="9" height="9" viewBox="0 0 24 24"><path d="M21.35 11.1H12v2.8h5.35c-.5 2.3-2.5 3.9-5.35 3.9-3.3 0-6-2.7-6-6s2.7-6 6-6c1.5 0 2.9.6 3.95 1.55L18.1 5.1C16.45 3.55 14.35 2.6 12 2.6 6.75 2.6 2.5 6.85 2.5 12.1s4.25 9.5 9.5 9.5c5.5 0 9.1-3.85 9.1-9.3 0-.7-.1-1.25-.25-1.7z" fill="#4285F4"/></svg>
                    Google
                  </span>
                  <% } else { %>
                  <span style="background:#f0faf5;border:1px solid #b2dfdb;border-radius:10px;padding:.1rem .45rem;font-size:.68rem;color:#00663A;font-weight:600">Manual</span>
                  <% } %>
                </div>
                <p style="font-size:.83rem;font-style:italic;color:var(--admin-gray);margin-bottom:.4rem;line-height:1.5">"<%= t.quote.length>140 ? t.quote.slice(0,140)+'…' : t.quote %>"</p>
                <span style="font-size:.78rem;font-weight:600;color:var(--admin-dark)"><%= t.name %></span>
                <span style="font-size:.73rem;color:var(--admin-gray)"> — <%= t.role %><% if(t.campus){ %>, <%= t.campus %><% } %></span>
              </div>
              <form method="POST" action="/admin/testimonials/<%= t.id %>/delete" onsubmit="return confirm('Delete?')" style="flex-shrink:0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
              </form>
            </div>
          </div>
          <% }) %>
          <% } else { %>
          <div class="empty-state"><i class="fas fa-quote-left"></i><p>No testimonials yet. Add one or sync Google Reviews.</p></div>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</div>
<script src="/js/admin.js"></script>
<script>
(function(){
  const btns = document.querySelectorAll('.star-btn');
  btns.forEach(btn => {
    btn.addEventListener('mouseenter', () => {
      const val = +btn.dataset.val;
      btns.forEach(b => b.style.color = +b.dataset.val <= val ? '#FBBF24' : '#D1D5DB');
    });
    btn.addEventListener('mouseleave', () => {
      const checked = document.querySelector('input[name="rating"]:checked');
      const val = checked ? +checked.value : 5;
      btns.forEach(b => b.style.color = +b.dataset.val <= val ? '#FBBF24' : '#D1D5DB');
    });
    btn.addEventListener('click', () => {
      const radio = btn.closest('label').querySelector('input[type="radio"]');
      radio.checked = true;
    });
  });
})();
</script>
</body>
</html>
