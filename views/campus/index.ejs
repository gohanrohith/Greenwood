<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= campus.description %>">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/campus.css">
  <style>:root{--campus-primary:<%= campus.theme.primary %>;--campus-accent:<%= campus.theme.accent %>;--campus-light:<%= campus.theme.light %>;}</style>
</head>
<body class="site-campus campus-<%= campus.slug %>">
<%- include('../partials/topbar-campus') %>
<%- include('../partials/nav-campus') %>
<main>

  <!-- HERO -->
  <section class="campus-hero" style="background-image:url('/images/campuses/<%= campus.slug %>-hero.jpg')">
    <div class="hero-overlay"></div>
    <div class="container campus-hero-content">
      <span class="campus-hero-tag"><%= campus.board %> &nbsp;|&nbsp; <%= campus.type %></span>
      <h1><%= campus.name %></h1>
      <p><%= campus.tagline %></p>
      <div class="hero-actions">
        <a href="<%= campusBase %>/admissions" class="btn btn-primary">Apply for Admissions</a>
        <a href="<%= campusBase %>/contact" class="btn btn-outline-white">Contact Us</a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="campus-stats-bar">
    <div class="container stats-grid">
      <div class="stat-item">
        <span class="stat-number"><%= campus.board === 'CBSE' ? 'CBSE' : 'State Board' %></span>
        <span class="stat-label">Board</span>
      </div>
      <div class="stat-item">
        <span class="stat-number"><%= campus.type %></span>
        <span class="stat-label">Campus Type</span>
      </div>
      <div class="stat-item">
        <span class="stat-number"><%= campus.classes %></span>
        <span class="stat-label">Classes Offered</span>
      </div>
      <% if (campus.established) { %>
      <div class="stat-item">
        <span class="stat-number">Est. <%= campus.established %></span>
        <span class="stat-label">Since</span>
      </div>
      <% } else { %>
      <div class="stat-item">
        <span class="stat-number"><%= campus.facilities.length %>+</span>
        <span class="stat-label">Facilities</span>
      </div>
      <% } %>
    </div>
  </section>

  <!-- ABOUT SNIPPET -->
  <section class="section">
    <div class="container campus-about-grid">
      <div class="campus-about-image">
        <img src="/images/campuses/<%= campus.slug %>.jpg" alt="<%= campus.name %>"
             onerror="this.style.display='none'">
      </div>
      <div class="campus-about-text">
        <span class="section-tag">About <%= campus.shortName %></span>
        <h2><%= campus.name %></h2>
        <p><%= campus.description %></p>
        <div class="vision-mission-grid">
          <div class="vision-card">
            <h4><i class="fas fa-eye"></i> Our Vision</h4>
            <p>"<%= school.vision %>"</p>
          </div>
          <div class="vision-card">
            <h4><i class="fas fa-bullseye"></i> Our Mission</h4>
            <p>"<%= school.mission %>"</p>
          </div>
        </div>
        <ul class="campus-highlights">
          <% campus.highlights.slice(0, 5).forEach(h => { %>
          <li><i class="fas fa-check-circle"></i> <%= h %></li>
          <% }) %>
        </ul>
        <a href="<%= campusBase %>/about" class="btn btn-primary" style="margin-top:1.25rem">Learn More</a>
      </div>
    </div>
  </section>

  <!-- DIRECTORS & PRINCIPAL -->
  <section class="section bg-light">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Our Leadership</span>
        <h2>Guided by Vision</h2>
        <p>Our institution is shaped by the dedication of its founding directors and campus principals.</p>
      </div>
      <div class="directors-grid">
        <% school.directors.slice(0, campus.directorCount || 2).forEach(d => { %>
        <div class="director-card">
          <div class="director-photo">
            <img src="<%= d.photo %>" alt="<%= d.name %>"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            <div class="director-photo-placeholder" style="display:none"><i class="fas fa-user"></i></div>
          </div>
          <div class="director-role"><%= d.role %></div>
          <h3 class="director-name"><%= d.name %></h3>
          <p class="director-designation"><%= d.designation %></p>
          <p class="director-bio"><%= d.bio %></p>
        </div>
        <% }) %>
        <div class="principal-info-card">
          <div class="principal-icon"><i class="fas fa-user-tie"></i></div>
          <div class="principal-label">Campus Principal</div>
          <h3><%= campus.principal %></h3>
          <p>Academic Head, <%= campus.name %></p>
          <a href="<%= campusBase %>/about" class="btn btn-sm btn-outline" style="margin-top:1rem">Meet Our Team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FGES FINNISH EDUCATION PARTNERSHIP (Mancherial only) -->
  <% if (campus.fges) { %>
  <section class="section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center">
        <div>
          <span class="section-tag">International Partnership</span>
          <h2 style="font-size:1.6rem;font-weight:700;color:var(--navy);margin:.75rem 0 1rem">Finnish Education Partnership</h2>
          <p style="color:var(--gray);font-size:.94rem;line-height:1.85;margin-bottom:1.25rem">
            Greenwood Mancherial is proud to partner with <strong>FGES, Finland</strong> — bringing Finnish pedagogical excellence to our campus. Finland's education system is globally recognised for its student-centred approach, emphasis on curiosity-driven learning, and outstanding outcomes.
          </p>
          <p style="color:var(--gray);font-size:.94rem;line-height:1.85;margin-bottom:1.75rem">
            Through this collaboration, our students benefit from Finnish-inspired teaching methodologies, teacher training, and curriculum enrichment that complements the CBSE framework — blending global best practices with India's academic rigour.
          </p>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:.6rem;margin-bottom:1.75rem">
            <% [
              'Student-centred, inquiry-based learning',
              'Collaborative classroom culture',
              'Focus on critical thinking over rote learning',
              'Teacher professional development with Finnish educators',
              'Holistic assessment — beyond test scores'
            ].forEach(item => { %>
            <li style="display:flex;align-items:flex-start;gap:.6rem;font-size:.9rem;color:var(--gray-dark)">
              <i class="fas fa-check-circle" style="color:var(--green);margin-top:.15rem;flex-shrink:0"></i>
              <%= item %>
            </li>
            <% }) %>
          </ul>
          <a href="https://fges.fi/" target="_blank" rel="noopener" class="btn btn-outline" style="display:inline-flex;align-items:center;gap:.5rem">
            <i class="fas fa-external-link-alt" style="font-size:.8rem"></i> Learn about FGES Finland
          </a>
        </div>
        <div>
          <div style="border-radius:var(--radius-lg);overflow:hidden;background:linear-gradient(135deg,#003580 0%,#005bbd 50%,#ffffff 100%);height:340px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2.5rem;text-align:center;position:relative">
            <img src="/images/partners/fges-logo.png" alt="FGES Finland"
                 style="max-width:180px;margin-bottom:1.5rem"
                 onerror="this.style.display='none'">
            <div style="width:70px;height:70px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <i class="fas fa-globe-europe" style="font-size:2rem;color:#fff"></i>
            </div>
            <p style="color:#fff;font-size:1.1rem;font-weight:700;margin-bottom:.4rem">FGES Finland</p>
            <p style="color:rgba(255,255,255,.75);font-size:.85rem">Finnish Education &amp; Global Skills</p>
            <div style="margin-top:1.5rem;display:flex;align-items:center;gap:.5rem">
              <span style="display:inline-block;width:18px;height:11px;background:#003580;border:1px solid rgba(255,255,255,.3);border-radius:2px"></span>
              <span style="color:rgba(255,255,255,.65);font-size:.78rem">Finland</span>
              <span style="color:rgba(255,255,255,.3);margin:0 .25rem">×</span>
              <span style="display:inline-block;width:18px;height:11px;background:linear-gradient(180deg,#FF9933 33%,#fff 33%,#fff 66%,#138808 66%);border-radius:2px"></span>
              <span style="color:rgba(255,255,255,.65);font-size:.78rem">India</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- KEY FACILITIES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Infrastructure</span>
        <h2>World-Class Facilities</h2>
        <p>Everything your child needs to learn, grow, and thrive — all in one campus.</p>
      </div>
      <div class="facilities-icon-grid">
        <%
        const facilityIcons = {
          'Science Lab': 'fas fa-flask', 'Science Labs': 'fas fa-flask',
          'Composite Science Lab': 'fas fa-flask', 'Composite Science Laboratory': 'fas fa-flask',
          'Computer Lab': 'fas fa-desktop',
          'Library': 'fas fa-book', 'Digital Library': 'fas fa-book-open',
          'Sports Ground': 'fas fa-running', 'Multi-Purpose Sports Arena': 'fas fa-running',
          'Transport': 'fas fa-bus',
          'CCTV Surveillance': 'fas fa-shield-alt',
          'Smart Classrooms': 'fas fa-chalkboard',
          'Medical Room': 'fas fa-heartbeat',
          'Boys & Girls Hostel': 'fas fa-home',
          'Dining Hall': 'fas fa-utensils',
          'Math Excellence Centre': 'fas fa-calculator',
          'Textile Skill Lab': 'fas fa-scissors',
          'Pottery Lab': 'fas fa-palette',
          'Public Speaking Lab': 'fas fa-microphone-alt',
          'Playground': 'fas fa-child'
        };
        campus.facilities.forEach(f => {
          const icon = facilityIcons[f] || 'fas fa-star';
        %>
        <div class="facility-icon-card">
          <div class="facility-icon-wrap"><i class="<%= icon %>"></i></div>
          <span><%= f %></span>
        </div>
        <% }) %>
      </div>
      <div class="section-cta">
        <a href="<%= campusBase %>/facilities" class="btn btn-primary">Explore All Facilities</a>
      </div>
    </div>
  </section>

  <!-- ADMISSIONS CTA BAND -->
  <section class="admissions-cta">
    <div class="container">
      <div class="cta-content">
        <h2>Admissions Open 2025–26 — <%= campus.name %></h2>
        <p>Join the Greenwood family. Limited seats available. Apply early to secure your child's future.</p>
        <div class="cta-actions">
          <a href="<%= campusBase %>/admissions" class="btn btn-white">Apply Online</a>
          <a href="<%= campusBase %>/contact" class="btn btn-outline-white">Schedule a Visit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT PREVIEW -->
  <section class="section">
    <div class="container campus-contact-preview">
      <div>
        <h2>Find Us</h2>
        <p style="color:var(--gray);margin:.5rem 0 1.5rem;font-size:.94rem">
          We'd love to show you around the campus. Reach out and we'll arrange a visit at your convenience.
        </p>
        <ul class="contact-list">
          <li><i class="fas fa-map-marker-alt"></i> <%= campus.address %></li>
          <li><i class="fas fa-phone"></i> <%= campus.phone %></li>
          <li><i class="fas fa-envelope"></i> <%= campus.email %></li>
          <li><i class="fab fa-whatsapp"></i> <%= campus.whatsapp %></li>
        </ul>
        <div style="margin-top:1.75rem;display:flex;gap:1rem;flex-wrap:wrap">
          <a href="<%= campusBase %>/contact" class="btn btn-primary">Contact Us</a>
          <a href="<%= campusBase %>/admissions" class="btn btn-outline">Admissions Enquiry</a>
        </div>
      </div>
      <div class="campus-map-embed">
        <% if (campus.mapEmbed) { %>
        <iframe src="<%= campus.mapEmbed %>" width="100%" height="340"
                style="border:0;border-radius:var(--radius-lg);display:block"
                allowfullscreen loading="lazy"></iframe>
        <% } else { %>
        <div class="map-placeholder">
          <i class="fas fa-map-marked-alt"></i>
          <p><strong><%= campus.name %></strong></p>
          <p><%= campus.address %></p>
          <a href="https://www.google.com/maps/search/<%= encodeURIComponent(campus.name + ' ' + campus.address) %>"
             target="_blank" rel="noopener" class="btn btn-sm btn-outline" style="margin-top:1rem">
            Open in Google Maps
          </a>
        </div>
        <% } %>
      </div>
    </div>
  </section>

</main>
<%- include('../partials/footer-campus') %>
<a href="https://wa.me/<%= campus.whatsapp.replace(/\D/g,'') %>" class="whatsapp-float" target="_blank" rel="noopener">
  <i class="fab fa-whatsapp"></i>
</a>
<script src="/js/main.js"></script>
</body>
</html>
