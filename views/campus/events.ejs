<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/campus.css">
  <style>:root{--campus-primary:<%= campus.theme.primary %>;--campus-accent:<%= campus.theme.accent %>;--campus-light:<%= campus.theme.light %>;}</style>
</head>
<body class="site-campus campus-<%= campus.slug %>">
<%- include('../partials/topbar-campus') %>
<%- include('../partials/nav-campus') %>
<main>

  <section class="page-hero" style="background:linear-gradient(120deg,var(--campus-primary),var(--navy))">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <h1>Events & Activities</h1>
      <p>Campus life at <%= campus.name %></p>
      <div class="breadcrumb"><a href="<%= campusBase %>">Home</a> / Events</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <% if (events && events.length > 0) { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px">
        <% events.forEach(ev => { %>
        <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--shadow);overflow:hidden;transition:transform .2s" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
          <% if (ev.image) { %>
          <img src="/uploads/gallery/<%= ev.image %>" alt="<%= ev.title %>" style="width:100%;height:180px;object-fit:cover">
          <% } else { %>
          <div style="height:70px;background:linear-gradient(120deg,var(--campus-primary),var(--navy));display:flex;align-items:center;justify-content:center">
            <i class="fas fa-calendar-star" style="font-size:1.5rem;color:var(--lime)"></i>
          </div>
          <% } %>
          <div style="padding:1.25rem">
            <% if (ev.event_date) { %>
            <div style="font-size:.75rem;font-weight:700;color:var(--campus-primary);text-transform:uppercase;letter-spacing:.5px;margin-bottom:.4rem">
              <i class="fas fa-calendar"></i> <%= new Date(ev.event_date).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %>
            </div>
            <% } %>
            <% if (ev.category) { %><span style="font-size:.7rem;background:var(--campus-light);color:var(--campus-primary);padding:2px 9px;border-radius:10px;font-weight:700;margin-bottom:.6rem;display:inline-block;text-transform:capitalize"><%= ev.category %></span><% } %>
            <h3 style="font-size:1rem;font-weight:700;color:var(--navy);margin-bottom:.5rem;line-height:1.4"><%= ev.title %></h3>
            <% if (ev.description) { %><p style="font-size:.85rem;color:var(--gray);line-height:1.65"><%= ev.description.substring(0,120) %><%= ev.description.length>120?'...':'' %></p><% } %>
            <% if (ev.source === 'gtimes' && ev.gtimes_url) { %>
            <a href="<%= ev.gtimes_url %>" target="_blank" rel="noopener" style="font-size:.8rem;color:var(--campus-primary);font-weight:600;display:inline-flex;align-items:center;gap:.35rem;margin-top:.75rem">Read on GTimes <i class="fas fa-external-link-alt"></i></a>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div style="text-align:center;padding:5rem;color:var(--gray)">
        <i class="fas fa-calendar-alt" style="font-size:3.5rem;opacity:.2;margin-bottom:1.5rem;display:block"></i>
        <h3 style="font-size:1.05rem;margin-bottom:.5rem">No events posted yet</h3>
        <p>Check back soon for upcoming events and activities at <%= campus.name %>.</p>
        <a href="http://gtimes.in" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top:1.25rem">Follow us on GTimes</a>
      </div>
      <% } %>
    </div>
  </section>

  <section style="background:var(--campus-primary);padding:52px 0;text-align:center;color:var(--white)">
    <div class="container">
      <h2 style="font-size:1.5rem;margin-bottom:.5rem">Stay Updated</h2>
      <p style="opacity:.85;margin-bottom:1.5rem">Follow campus news, events, and achievements on GTimes — Greenwood's media platform.</p>
      <a href="http://gtimes.in" target="_blank" rel="noopener" class="btn btn-white">Visit GTimes</a>
      <a href="<%= campusBase %>/notices" class="btn btn-outline-white" style="margin-left:.75rem">View Notices</a>
    </div>
  </section>

</main>
<%- include('../partials/footer-campus') %>
<a href="https://wa.me/<%= campus.whatsapp.replace(/\D/g,'') %>" class="whatsapp-float" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i></a>
<script src="/js/main.js"></script>
</body>
</html>
