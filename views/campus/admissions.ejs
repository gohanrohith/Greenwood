<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/campus.css">
  <style>:root{--campus-primary:<%= campus.theme.primary %>;--campus-accent:<%= campus.theme.accent %>;--campus-light:<%= campus.theme.light %>;}</style>
</head>
<body class="site-campus campus-<%= campus.slug %>">
<%- include('../partials/topbar-campus') %>
<%- include('../partials/nav-campus') %>
<main>

  <section class="page-hero" style="background:linear-gradient(120deg,var(--campus-primary),var(--navy))">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <h1>Admissions 2025–26</h1>
      <p><%= campus.name %> — <%= campus.board %> · <%= campus.classes %></p>
      <div class="breadcrumb"><a href="<%= campusBase %>">Home</a> / Admissions</div>
    </div>
  </section>

  <% if (success) { %>
  <div style="background:#d1fae5;border:1px solid #6ee7b7;color:#065f46;padding:1.25rem;text-align:center;font-weight:600">
    <i class="fas fa-check-circle"></i> Your enquiry has been submitted! We'll contact you within 24 hours.
  </div>
  <% } %>

  <section class="section">
    <div class="container admissions-grid">

      <!-- FORM -->
      <div>
        <span class="section-tag">Enquiry Form</span>
        <h2 style="margin:.75rem 0 .5rem;color:var(--navy)">Submit Your Enquiry</h2>
        <p style="color:var(--gray);margin-bottom:2rem;font-size:.92rem">Our admissions team will contact you within 24 hours to guide you through the next steps.</p>
        <form action="<%= campusBase %>/admissions/enquiry" method="POST" class="enquiry-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="form-group">
              <label>Parent / Guardian Name *</label>
              <input type="text" name="name" required placeholder="Full name">
            </div>
            <div class="form-group">
              <label>Phone Number *</label>
              <input type="tel" name="phone" required placeholder="+91 XXXXXXXXXX">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="your@email.com">
            </div>
            <div class="form-group">
              <label>Student Name</label>
              <input type="text" name="student_name" placeholder="Child's name">
            </div>
          </div>
          <div class="form-group">
            <label>Class Seeking Admission</label>
            <select name="class">
              <option value="">Select Class</option>
              <option>Pre-KG</option><option>LKG</option><option>UKG</option>
              <% for(let i=1;i<=12;i++) { %><option>Class <%= i %></option><% } %>
            </select>
          </div>
          <div class="form-group">
            <label>Message / Questions</label>
            <textarea name="message" rows="4" placeholder="Any specific questions..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self:flex-start;background:var(--campus-primary);border-color:var(--campus-primary);padding:13px 32px">
            <i class="fas fa-paper-plane" style="margin-right:.5rem"></i> Submit Enquiry
          </button>
        </form>
      </div>

      <!-- INFO -->
      <div>
        <span class="section-tag">Campus Info</span>
        <h2 style="margin:.75rem 0 1.5rem;color:var(--navy)"><%= campus.name %></h2>

        <div style="background:var(--campus-light);border-radius:var(--radius-lg);padding:1.75rem;margin-bottom:1.75rem">
          <div style="display:flex;flex-direction:column;gap:.75rem">
            <div style="display:flex;gap:.75rem;align-items:center"><i class="fas fa-graduation-cap" style="color:var(--campus-primary);width:18px"></i><span style="font-size:.9rem;color:var(--gray-dark)"><strong>Classes:</strong> <%= campus.classes %></span></div>
            <div style="display:flex;gap:.75rem;align-items:center"><i class="fas fa-certificate" style="color:var(--campus-primary);width:18px"></i><span style="font-size:.9rem;color:var(--gray-dark)"><strong>Board:</strong> <%= campus.board %></span></div>
            <div style="display:flex;gap:.75rem;align-items:center"><i class="fas fa-home" style="color:var(--campus-primary);width:18px"></i><span style="font-size:.9rem;color:var(--gray-dark)"><strong>Type:</strong> <%= campus.type %></span></div>
            <div style="display:flex;gap:.75rem;align-items:flex-start"><i class="fas fa-map-marker-alt" style="color:var(--campus-primary);width:18px;margin-top:.2rem"></i><span style="font-size:.9rem;color:var(--gray-dark)"><strong>Address:</strong> <%= campus.address %></span></div>
            <div style="display:flex;gap:.75rem;align-items:center"><i class="fas fa-phone" style="color:var(--campus-primary);width:18px"></i><span style="font-size:.9rem;color:var(--gray-dark)"><strong>Phone:</strong> <%= campus.phone %></span></div>
          </div>
        </div>

        <h3 style="color:var(--navy);margin-bottom:1rem">Documents Required</h3>
        <div style="display:flex;flex-direction:column;gap:.5rem">
          <% [
            'Birth Certificate (original + photocopy)',
            'Previous School TC (if applicable)',
            'Last class report card / mark sheet',
            'Aadhar Card of student and parent',
            '4 passport-size photographs',
            'Residence proof',
          ].forEach(d => { %>
          <div style="display:flex;align-items:flex-start;gap:.6rem;font-size:.86rem;color:var(--gray-dark)">
            <i class="fas fa-check" style="color:var(--campus-primary);margin-top:.2rem;flex-shrink:0;font-size:.75rem"></i> <%= d %>
          </div>
          <% }) %>
        </div>

        <div style="background:var(--white);border:1px solid var(--gray-light);border-radius:var(--radius);padding:1.25rem;margin-top:1.75rem">
          <h4 style="color:var(--navy);margin-bottom:.75rem;font-size:.92rem"><i class="fab fa-whatsapp" style="color:#25d366;margin-right:.4rem"></i> WhatsApp Us</h4>
          <p style="font-size:.84rem;color:var(--gray);margin-bottom:.75rem">Quick questions? Message our admissions team directly on WhatsApp.</p>
          <a href="https://wa.me/<%= campus.whatsapp.replace(/\D/g,'') %>?text=Hi, I'm interested in admissions at <%= encodeURIComponent(campus.name) %>" target="_blank" rel="noopener" class="btn btn-sm" style="background:#25d366;color:var(--white);border:none">Chat on WhatsApp</a>
        </div>
      </div>

    </div>
  </section>

</main>
<%- include('../partials/footer-campus') %>
<a href="https://wa.me/<%= campus.whatsapp.replace(/\D/g,'') %>" class="whatsapp-float" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i></a>
<script src="/js/main.js"></script>
</body>
</html>
