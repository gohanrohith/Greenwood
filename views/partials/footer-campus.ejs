<footer class="footer-campus">
  <div class="footer-top">
    <div class="container footer-grid">
      <div class="footer-col">
        <div class="footer-brand">
          <div class="footer-brand-lockup">
            <img src="/emblem.png" alt="" class="footer-emblem-icon"
                 onerror="this.style.display='none'">
            <img src="/White%20Logo.png" alt="<%= campus.name %>" class="footer-logo-img"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='inline'">
            <span class="footer-logo-text" style="display:none"><%= campus.name %></span>
          </div>
          <p><%= campus.board %> | <%= campus.type %></p>
          <p><%= campus.address %></p>
        </div>
      </div>

      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="<%= campusBase %>">Home</a></li>
          <li><a href="<%= campusBase %>/about">About Campus</a></li>
          <li><a href="<%= campusBase %>/academics">Academics</a></li>
          <li><a href="<%= campusBase %>/facilities">Facilities</a></li>
          <li><a href="<%= campusBase %>/events">Events</a></li>
          <li><a href="<%= campusBase %>/gallery">Gallery</a></li>
          <li><a href="<%= campusBase %>/notices">Notices</a></li>
          <li><a href="<%= campusBase %>/downloads">Downloads</a></li>
          <li><a href="<%= campusBase %>/disclosure"><%= campus.cbse ? 'Mandatory Disclosure' : 'School Information' %></a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <ul class="footer-contact">
          <li><i class="fas fa-map-marker-alt"></i> <%= campus.address %></li>
          <li><i class="fas fa-phone"></i> <%= campus.phone %></li>
          <li><i class="fas fa-envelope"></i> <%= campus.email %></li>
        </ul>
        <a href="<%= campusBase %>/admissions" class="btn-footer-cta">Apply Now</a>
      </div>

      <div class="footer-col">
        <h4>Greenwood Group</h4>
        <ul>
          <li><a href="/">Main Website</a></li>
          <li><a href="/hasanparthy">Hasanparthy (CBSE)</a></li>
          <li><a href="/hunterroad">Hunter Road (CBSE)</a></li>
          <li><a href="/mancherial">Mancherial (CBSE)</a></li>
          <li><a href="/naimnagar">Naimnagar (State Board)</a></li>
          <li><a href="/gopalpur">Gopalpur (State Board)</a></li>
          <li><a href="http://gtimes.in">GTimes</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; <%= currentYear %> <%= campus.name %> | Greenwood High School Warangal. All rights reserved.</p>
    </div>
  </div>
</footer>

