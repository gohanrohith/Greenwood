# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenwood_db
DB_USER=root
DB_PASS=

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Main domain (used for subdomain detection)
# Local dev: lvh.me   |   Production: ghs.ac.in
MAIN_DOMAIN=lvh.me

# Email (for contact forms - optional in dev)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=office@ghs.ac.in
MAIL_PASS=
MAIL_FROM=Greenwood High School <office@ghs.ac.in>

# GTimes webhook secret (shared with GTimes platform - must match on both sides)
GTIMES_WEBHOOK_SECRET=change-this-to-a-long-random-string

